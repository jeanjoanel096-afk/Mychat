<!DOCTYPE html>
<html lang="ht">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MyChat</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
        body { background-color: #0b0c10; color: #ffffff; display: flex; flex-direction: column; align-items: center; padding: 10px; min-height: 100vh; justify-content: center; }
        .phone-container { width: 100%; max-width: 400px; background: #1f2833; border-radius: 20px; min-height: 85vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0px 8px 24px rgba(0,0,0,0.5); border: 2px solid #45f3ff; }
        
        /* Stil pou Paj Auth la */
        .auth-container { padding: 30px 20px; display: flex; flex-direction: column; gap: 15px; justify-content: center; flex: 1; text-align: center; }
        .auth-container h2 { color: #45f3ff; margin-bottom: 10px; }
        .auth-toggle { font-size: 0.9rem; color: #aaa; cursor: pointer; text-decoration: underline; margin-top: 10px; }

        /* Stil prensipal Aplikasyon an (kache pa defo si itilizatè pa konekte) */
        .app-content { display: none; flex-direction: column; flex: 1; }
        .app-header { background: linear-gradient(135deg, #6f42c1, #45f3ff); padding: 15px; text-align: center; font-weight: bold; font-size: 1.2rem; }
        .balance-badge { background: rgba(0, 0, 0, 0.4); padding: 5px 12px; border-radius: 15px; font-size: 0.9rem; margin-top: 5px; display: inline-block; color: #45f3ff; }
        .nav-tabs { display: flex; background: #151a21; border-bottom: 1px solid #333; }
        .tab-btn { flex: 1; padding: 12px; background: none; border: none; color: #888; font-weight: bold; cursor: pointer; text-align: center; }
        .tab-btn.active { color: #45f3ff; border-bottom: 3px solid #45f3ff; background: rgba(69, 243, 255, 0.05); }
        .tab-content { flex: 1; padding: 15px; display: none; overflow-y: auto; }
        .tab-content.active { display: block; }
        
        .search-container { display: flex; gap: 5px; margin-bottom: 10px; }
        .search-input { background: #0b0c10; border: 1px solid #45f3ff; padding: 8px; border-radius: 8px; color: white; font-size: 0.85rem; }
        .search-btn { background: #45f3ff; border: none; padding: 0 12px; border-radius: 8px; font-weight: bold; cursor: pointer; color: #0b0c10; }

        .chat-box { height: 220px; background: #0b0c10; border-radius: 10px; padding: 10px; overflow-y: auto; margin-bottom: 10px; border: 1px solid #333; }
        .message { margin-bottom: 10px; padding: 8px 12px; border-radius: 10px; max-width: 80%; font-size: 0.9rem; }
        .msg-received { background: #2c3540; align-self: flex-start; }
        .msg-sent { background: #6f42c1; margin-left: auto; text-align: right; }
        .chat-input-area { display: flex; gap: 5px; }
        input, select { flex: 1; padding: 10px; border-radius: 8px; border: 1px solid #444; background: #0b0c10; color: white; }
        button.action-btn { background: #45f3ff; color: #0b0c10; border: none; padding: 10px 15px; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 10px; }
        .ad-card { background: #252e3d; border-radius: 12px; padding: 15px; text-align: center; border-left: 5px solid #6f42c1; }
        .form-group { margin-bottom: 15px; text-align: left; }
        .form-group label { display: block; margin-bottom: 5px; font-size: 0.85rem; color: #aaa; }
        .ad-modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.9); z-index: 100; justify-content: center; align-items: center; flex-direction: column; }
        .ad-countdown { font-size: 3rem; color: #45f3ff; margin-bottom: 10px; }
        .support-btn { background: #25D366; color: white; border: none; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; width: 100%; margin-top: 20px; display: block; text-align: center; text-decoration: none; }
    </style>
</head>
<body>
<div class="phone-container">
    
    <div id="auth-screen" class="auth-container">
        <h2 id="auth-title">Konekte sou MyChat</h2>
        <div class="form-group" id="username-group" style="display: none;">
            <label>Non Itilizatè (Username)</label>
            <input type="text" id="auth-username" placeholder="Ex: bòskodè01">
        </div>
        <div class="form-group">
            <label>Adrès Imel (Email)</label>
            <input type="email" id="auth-email" placeholder="Ex: nonou@gmail.com">
        </div>
        <div class="form-group">
            <label>Modpas</label>
            <input type="password" id="auth-password" placeholder="••••••••">
        </div>
        <button class="action-btn" id="auth-btn" onclick="handleAuth()">Konekte</button>
        <span class="auth-toggle" id="auth-toggle-text" onclick="toggleAuthMode()">Pa gen kont? Enskri la a</span>
    </div>

    <div id="main-app" class="app-content">
        <div class="app-header">
            <span>MyChat 📱</span><br>
            <div class="balance-badge">💰 <span id="user-pwen">0</span> Pwen</div>
        </div>
        <div class="nav-tabs">
            <button class="tab-btn active" onclick="switchTab(event, 'chat')">💬 Chat</button>
            <button class="tab-btn" onclick="switchTab(event, 'earn')">💸 Fè Lajan</button>
            <button class="tab-btn" onclick="switchTab(event, 'withdraw')">🏦 Retrè</button>
            <button class="tab-btn" onclick="switchTab(event, 'settings')">⚙️ Reglaj</button>
        </div>
        
        <div id="tab-chat" class="tab-content active">
            <div class="search-container">
                <input type="text" id="search-user" class="search-input" placeholder="Chèche yon itilizatè pa non li...">
                <button class="search-btn" onclick="searchUser()">🔍</button>
            </div>
            <div class="chat-box" id="chat-box">
                <div class="message msg-received"><b>@Zanmi:</b> Swaap! Ki sakap fèt? 👋</div>
                <div class="message msg-sent"><b>Ou:</b> Map test nouvo app m lan la bro! 🔥</div>
            </div>
            <div class="chat-input-area">
                <input type="text" id="chat-input" placeholder="Ekri yon mesaj...">
                <button onclick="sendMsg()" style="background:#45f3ff; border:none; padding:10px; border-radius:8px; font-weight:bold; cursor:pointer; color:#0b0c10;">Voye</button>
            </div>
        </div>
        
        <div id="tab-earn" class="tab-content">
            <div class="ad-card">
                <h3>Piblisite Videyo 📺</h3>
                <p style="font-size:0.85rem; color:#ccc; margin-bottom:10px;">Gade yon videyo 5 segonn pou w genyen 10 pwen.</p>
                <button class="action-btn" onclick="startAdSimulation()">Gade Videyo</button>
            </div>
        </div>
        
        <div id="tab-withdraw" class="tab-content">
            <h3>Retire Lajan sou MonCash</h3>
            <p style="font-size:0.85rem; color:#aaa; margin-top:5px;">Kondisyon: Omwen 200 pwen.</p>
            <p style="font-size:0.85rem; color:#ff4545; margin-bottom:15px;">Maksimòm pou chak retrè: 50$</p>
            <div class="form-group">
                <label>Nimewo MonCash ou</label>
                <input type="text" id="withdraw-moncash" placeholder="Ex: 509...">
            </div>
            <div class="form-group">
                <label>Kantite Pwen pou Retire</label>
                <input type="number" id="withdraw-amount" placeholder="Ex: 200">
            </div>
            <button class="action-btn" style="background:#6f42c1; color:white;" onclick="requestWithdrawal()">Mande Peman</button>
        </div>
        
        <div id="tab-settings" class="tab-content">
            <h3>Reglaj Pwofil</h3>
            <div class="form-group" style="margin-top:15px;">
                <label>Chanje Lang</label>
                <select id="set-lang" onchange="saveSettings()">
                    <option value="ht">Kreyòl Ayisyen</option>
                    <option value="fr">Français</option>
                    <option value="en">English</option>
                </select>
            </div>
            <div class="form-group">
                <label>Tèm Aplikasyon an</label>
                <select id="set-theme" onchange="saveSettings()">
                    <option value="dark">Nwa (Dark Mode)</option>
                    <option value="light">Klè (Light Mode)</option>
                </select>
            </div>
            <a href="https://wa.me/50935250313?text=Bonjou%20Sip%C3%B2%20MyChat%2C%20mwen%20bezwen%20yon%20asistans." target="_blank" class="support-btn">🟢 Kontakte Sipò (WhatsApp)</a>
        </div>
    </div>
</div>

<div class="ad-modal" id="ad-modal">
    <h3 style="color:white; margin-bottom:15px;">Piblisite ap Jwe...</h3>
    <div class="ad-countdown" id="ad-timer">5</div>
</div>

<script>
    let currentUsername = "";
    let authMode = "login"; // kapab "login" oswa "register"

    function toggleAuthMode() {
        let title = document.getElementById('auth-title');
        let btn = document.getElementById('auth-btn');
        let toggleText = document.getElementById('auth-toggle-text');
        let usernameGroup = document.getElementById('username-group');

        if(authMode === "login") {
            authMode = "register";
            title.innerText = "Kreye yon Kont";
            btn.innerText = "Enskri";
            toggleText.innerText = "Ou gen kont deja? Konekte la a";
            usernameGroup.style.display = "block";
        } else {
            authMode = "login";
            title.innerText = "Konekte sou MyChat";
            btn.innerText = "Konekte";
            toggleText.innerText = "Pa gen kont? Enskri la a";
            usernameGroup.style.display = "none";
        }
    }

    function handleAuth() {
        let email = document.getElementById('auth-email').value.trim();
        let password = document.getElementById('auth-password').value.trim();
        let username = document.getElementById('auth-username').value.trim();

        if(!email || !password || (authMode === 'register' && !username)) {
            alert("Tanpri ranpli tout espas yo!");
            return;
        }

        let endpoint = authMode === 'login' ? '/login' : '/register';
        let bodyData = { email: email, password: password };
        if(authMode === 'register') bodyData.username = username;

        fetch(endpoint, {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify(bodyData)
        })
        .then(res => res.json())
        .then(data => {
            if(data.success) {
                currentUsername = data.username;
                document.getElementById('user-pwen').innerText = data.pwen || 0;
                if(data.moncash) document.getElementById('withdraw-moncash').value = data.moncash;
                
                // Kache paj auth, louvri app a
                document.getElementById('auth-screen').style.display = 'none';
                document.getElementById('main-app').style.display = 'flex';
            } else {
                alert(data.message);
            }
        });
    }

    function switchTab(e, tabName) {
        document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(el => el.classList.remove('active'));
        document.getElementById('tab-' + tabName).classList.add('active');
        if (e && e.currentTarget) e.currentTarget.classList.add('active');
    }
    
    function searchUser() {
        let usernameToSearch = document.getElementById('search-user').value.trim();
        if(usernameToSearch === "") { alert("Tanpri tape non yon itilizatè!"); return; }
        let chatBox = document.getElementById('chat-box');
        chatBox.innerHTML = `<div class="message msg-received"><b>@Sistèm:</b> Ou konekte ak @${usernameToSearch}. Ou mèt kòmanse pale avè l! 💬</div>`;
        document.getElementById('search-user').value = "";
    }

    function sendMsg() {
        let input = document.getElementById('chat-input');
        if(input.value.trim() !== "") {
            let chatBox = document.getElementById('chat-box');
            let newMsg = document.createElement('div');
            newMsg.className = "message msg-sent";
            newMsg.innerHTML = `<b>Ou:</b> ${input.value}`;
            chatBox.appendChild(newMsg);
            chatBox.scrollTop = chatBox.scrollHeight;
            input.value = "";
        }
    }

    function startAdSimulation() {
        let modal = document.getElementById('ad-modal');
        let timerEl = document.getElementById('ad-timer');
        modal.style.display = 'flex';
        let count = 5;
        let interval = setInterval(() => {
            count--; timerEl.innerText = count;
            if(count <= 0) {
                clearInterval(interval); modal.style.display = 'none';
                fetch('/gade-piblisite', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({username: currentUsername})
                }).then(res => res.json()).then(data => {
                    if(data.success) {
                        document.getElementById('user-pwen').innerText = data.nouvo_balans;
                        alert(data.message);
                    }
                });
            }
        }, 1000);
    }

    function requestWithdrawal() {
        let pwen = document.getElementById('withdraw-amount').value;
        let moncash = document.getElementById('withdraw-moncash').value;
        fetch('/withdrawal', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({username: currentUsername, pwen: pwen, moncash: moncash})
        }).then(res => res.json()).then(data => {
            alert(data.message);
            if(data.success) { document.getElementById('user-pwen').innerText = data.nouvo_balans; }
        });
    }

    function saveSettings() {
        let theme = document.getElementById('set-theme').value;
        if(theme === 'light') { document.body.style.backgroundColor = '#f4f6f9'; document.body.style.color = '#333'; }
        else { document.body.style.backgroundColor = '#0b0c10'; document.body.style.color = '#ffffff'; }
    }
</script>
</body>
</html>
