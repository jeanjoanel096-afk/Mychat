# 1. Inisyalize kòm yon nouvo pwojè
git init

# 2. Ajoute tout dosye yo
git add .

# 3. Fè premye commit la
git commit -m "Premye version pwojè MyChat"

# 4. Chanje non branch la an "main"
git branch -M main

# 5. Konekte ak nouvo repo a (Sèvi ak URL nouvo repo ou fèk kreye a)
git remote add origin https://github.com/IT-User/MyChat-App.git

# 6. Pouse kòd la
git push -u origin main
